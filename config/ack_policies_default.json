            "initial_threshold": 2,
            "steady_threshold": 10,
            "switch_after_packet_number_advance": 100,
            "transition_boundary": "ack_instigating_pn>=least_observed_pn+100",
            "packet_number_spaces": {"initial": "immediate", "handshake": "immediate", "application_data": "ack-decimation"},
            "max_ack_delay_ms": 25,
            "timer_rule": "initial:25ms; steady:max(1ms,min(25ms,min_rtt/4))",
            "immediate_ack_conditions": ["threshold", "first four packets in newest range after a gap", "ECN transition to CE", "IMMEDIATE_ACK frame when explicitly negotiated"],
            "reordering_ack": "threshold 1 plus new-gap rule"

        },
        "chrome-like-ack": {
            "policy_name": "chrome-like-ack",
            "policy_version": "1.0.0",
            "reference": "https://github.com/google/quiche/blob/38097a7a48d5f7d0853ec0ece88269c08283c9c7/quiche/quic/core/quic_received_packet_manager.cc",
